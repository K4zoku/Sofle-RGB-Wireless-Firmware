menuconfig ZMK_VIA
    bool "VIA compatibility for ZMK"
    depends on RAW_HID
    depends on ZMK_KEYMAP_SETTINGS_STORAGE
    depends on DT_HAS_ZMK_VIA_MATRIX_ENABLED
    default y
    help
      Expose the current ZMK runtime keymap through the QMK/VIA Raw HID
      protocol. A board/keymap must provide a zmk,via-matrix node with
      rows, columns, and a map array of ZMK position indices.

config ZMK_VIA_CUSTOM_KEYCODES
    bool "Enable keyboard-specific VIA custom keycodes"
    depends on ZMK_VIA
    default n

config ZMK_VIA_ENCODER_READ
    bool "Expose static encoder bindings to VIA"
    depends on ZMK_VIA
    default n


config ZMK_VIA_CUSTOM_KEYCODE_PROFILE
    int "VIA custom keycode profile"
    depends on ZMK_VIA_CUSTOM_KEYCODES
    range 0 1
    default 0