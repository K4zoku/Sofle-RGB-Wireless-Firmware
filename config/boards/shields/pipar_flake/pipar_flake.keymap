#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define FUNC 1

/ {
    /* Generic VIA matrix adapter for this 3x3 keyboard. */
    via_matrix: via_matrix {
        compatible = "zmk,via-matrix";
        rows = <3>;
        columns = <3>;
        map = <0 1 2 3 4 5 6 7 8>;
    };

    behaviors {
        via_encoder: via_encoder {
            compatible = "zmk,via-encoder";
            #binding-cells = <1>;
            #sensor-binding-cells = <2>;
        };
        via_macro: via_macro {
            compatible = "zmk,via-macro";
            #binding-cells = <1>;
        };
        via_compat: via_compat {
            compatible = "zmk,via-compat";
            #binding-cells = <2>;
        };
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_1>;
        triggers-per-rotation = <20>;
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
            bindings = <
                &kp ESC  &kp SPACE  &to FUNC
                &kp BSPC &kp UP     &kp ENTER
                &kp LEFT &kp DOWN   &kp RIGHT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        function_layer {
            display-name = "function";
            bindings = <
                &none       &none       &to BASE
                &none       &kp C_MUTE  &bt BT_NXT
                &sys_reset  &bootloader &bt BT_CLR
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
